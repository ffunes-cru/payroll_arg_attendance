<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ruleset Convenio Argentina (Jornales LCT) -->
        <record id="ruleset_jornales_arg_lct" model="hr.attendance.overtime.ruleset">
            <field name="name">Convenio Argentina (Jornales LCT)</field>
            <field name="rate_combination_mode">max</field>
        </record>

        <!-- Regla 1: Horas Extras 50% (Exceso de Jornada Habitual) -->
        <record id="rule_horas_extras_50_arg" model="hr.attendance.overtime.rule">
            <field name="name">Horas Extras 50% (Exceso de Jornada Habitual)</field>
            <field name="base_off">quantity</field>
            <field name="timing_type">schedule</field>
            <field name="expected_hours_from_contract" eval="True"/>
            <field name="paid" eval="True"/>
            <field name="amount_rate" eval="1.5"/>
            <field name="ruleset_id" ref="ruleset_jornales_arg_lct"/>
        </record>

        <!-- Regla 2: Horas Extras 100% (Fines de Semana / No Laborables) -->
        <record id="rule_horas_extras_100_arg" model="hr.attendance.overtime.rule">
            <field name="name">Horas Extras 100% (Fines de Semana / No Laborables)</field>
            <field name="base_off">timing</field>
            <field name="timing_type">non_work_days</field>
            <field name="paid" eval="True"/>
            <field name="timing_start" eval="0.0"/>
            <field name="timing_stop" eval="24.0"/>
            <field name="amount_rate" eval="2.0"/>
            <field name="ruleset_id" ref="ruleset_jornales_arg_lct"/>
        </record>
    </data>
</odoo>
